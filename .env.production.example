# ===========================================
# Production Environment Variables
# Copy this to .env on your VPS
# ===========================================

# Database
POSTGRES_USER=vgfriend
POSTGRES_PASSWORD=your-very-strong-db-password-here
POSTGRES_DB=vgfriend

# JWT Secrets - Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-different-from-jwt-secret

# AI Provider - Groq is free and fast
GROQ_API_KEY=AQ.Ab8RN6JS1KxAMkNjMi2skstmT5L-aVHkNBmCQbgdhsZPAb77Rw


# CORS - Your frontend domain
CORS_ORIGIN=https://yourdomain.com

# Email (SMTP) - required for OTP/register/password-reset
# Gmail: use App Password (16 chars) from https://myaccount.google.com/apppasswords
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=VGfriend

# SMTP timeout tuning (milliseconds)
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# Optional HTTPS email API fallback (works over port 443)
# Set EMAIL_PROVIDER=resend to use API-first mode
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=otp@yourdomain.com
RESEND_API_URL=https://api.resend.com/emails

# Frontend URLs - Point to your API domain
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_URL=https://api.yourdomain.com

# GitHub Container Registry
GITHUB_REPOSITORY=your-username/VirtualGfriend
